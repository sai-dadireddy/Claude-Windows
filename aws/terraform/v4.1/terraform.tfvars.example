# =============================================================================
# Sherpa Platform v4.1 - Example Variables
# =============================================================================
# Copy this file to terraform.tfvars and update values as needed.
# DO NOT commit terraform.tfvars to version control if it contains secrets.
# =============================================================================

# Core Settings
aws_region   = "us-east-1"
environment  = "production"
project_name = "sherpa"

# Existing Resource IDs (for import)
api_gateway_id             = "hl98rmqgd6"
cognito_user_pool_id       = "us-east-1_DS0DWtBpu"
cloudfront_distribution_id = "dznfspanfl89s"
guardrail_id               = "0izv8dtovrwx"
guardrail_version          = "DRAFT"

# Lambda Configuration
lambda_s3_bucket   = "sherpa-lambda-deployments-458798750195"
lambda_layer_bucket = "sherpa-lambda-layers-458798750195"
lambda_layer_key    = "layers/boto3-bedrock-latest.zip"
log_level          = "INFO"

# WAF Configuration
waf_rate_limit = 2000

# Cognito Configuration
cognito_callback_urls = [
  "https://sherpa.example.com/callback",
  "http://localhost:3000/callback"
]
cognito_logout_urls = [
  "https://sherpa.example.com/logout",
  "http://localhost:3000/logout"
]
cognito_mfa_configuration = "OPTIONAL"

# Logging & Monitoring
log_retention_days = 90
enable_xray_tracing = true
# alarm_email = "alerts@example.com"

# Bedrock Model Configuration
bedrock_model_primary  = "anthropic.claude-opus-4-20250514"
bedrock_model_fallback = "anthropic.claude-sonnet-4-5-20241022-v2:0"
bedrock_max_tokens     = 4096

# Tags
cost_center = "platform"
owner       = "platform-team"

tags = {
  Application = "Sherpa"
  Team        = "Platform"
}
